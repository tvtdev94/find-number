{
  "name": "@find-number/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply find-number-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply find-number-db --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@find-number/shared": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.55.0",
    "ws": "^8.20.0"
  }
}
